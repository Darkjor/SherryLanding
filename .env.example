# ============================================================================
# Sherry Studio — variables de entorno (frontend)
#
# Copia este archivo a `.env` y rellena los valores.
# Encuentra ambos valores en Supabase: Settings -> API.
#
# El prefijo PUBLIC_ las expone al navegador (Astro/Vite). Es SEGURO:
# la anon key es pública por diseño; RLS protege los datos.
# NUNCA pongas aquí la service_role key ni el GITHUB_TOKEN.
# ============================================================================

# URL del proyecto Supabase, p.ej. https://abcdefgh.supabase.co
PUBLIC_SUPABASE_URL=

# Clave anónima (anon public). Settings -> API -> Project API keys -> anon public
PUBLIC_SUPABASE_ANON_KEY=
