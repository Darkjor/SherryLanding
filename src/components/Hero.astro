---
import Button from './ui/Button.astro';
import GoldDivider from './ui/GoldDivider.astro';
---

<section id="hero" class="min-h-screen bg-bone flex items-center justify-center pt-16 lg:pt-20">
  <div class="container-sherry text-center max-w-content py-24">
    <!-- Eyebrow label -->
    <p class="font-sans text-xs tracking-widest uppercase text-gold mb-8">
      Zapopan · Jalisco
    </p>

    <!-- Main headline -->
    <h1 class="font-serif text-5xl md:text-6xl lg:text-7xl text-burgundy leading-tight mb-6 text-balance">
      Where Beauty Becomes Ritual
      <span class="text-gold">✦</span>
    </h1>

    <GoldDivider class="mx-auto" />

    <!-- Subheadline -->
    <p class="font-garamond text-xl md:text-2xl text-gris leading-relaxed max-w-lg mx-auto mb-4">
      El espacio habla antes que nadie.
    </p>
    <p class="font-garamond text-lg text-gris-light max-w-md mx-auto mb-12">
      Una Luxury Beauty House diseñada para quienes saben que el lujo no se mide en el precio — se mide en cada detalle.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center items-center">
      <Button href="#cta" variant="primary">Reserva tu primer ritual</Button>
      <Button href="#membresias" variant="secondary">Ver membresías</Button>
    </div>

    <!-- Scroll indicator -->
    <div class="mt-20 flex flex-col items-center gap-2 opacity-50">
      <span class="label-sherry">Descubre</span>
      <div class="w-px h-12 bg-gris-dark animate-bounce"></div>
    </div>
  </div>
</section>
