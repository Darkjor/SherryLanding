---
import SectionLabel from './ui/SectionLabel.astro';
import GoldDivider from './ui/GoldDivider.astro';
import Button from './ui/Button.astro';
import { memberships } from '../data/memberships';
---

<section id="membresias" class="section-padding bg-bone">
  <div class="container-sherry">
    <div class="text-center mb-16">
      <SectionLabel>Membresías Sherry</SectionLabel>
      <h2 class="font-serif text-4xl md:text-5xl text-burgundy max-w-2xl mx-auto leading-tight">
        Tu ritual, todos los meses.
      </h2>
      <GoldDivider class="mx-auto" />
      <p class="font-garamond text-lg text-gris max-w-xl mx-auto">
        Elige el nivel que se adapta a ti. Sin contratos. Sin compromisos forzosos.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 lg:gap-10 items-end overflow-visible">
      {memberships.map((membership) => (
        <div
          class={`relative flex flex-col p-8 lg:p-10 transition-all duration-300 ${
            membership.recommended
              ? 'bg-burgundy text-bone shadow-2xl shadow-burgundy/30 md:scale-105 z-10'
              : 'bg-white border border-bone-dark hover:border-gold'
          }`}
        >
          {membership.recommended && (
            <div class="absolute -top-5 left-1/2 -translate-x-1/2">
              <span class="bg-gold text-burgundy font-sans text-xs tracking-widest uppercase px-5 py-1.5 whitespace-nowrap font-semibold">
                Más popular
              </span>
            </div>
          )}

          <!-- Header -->
          <div class="mb-6">
            <p class={`label-sherry mb-3 ${membership.recommended ? 'text-gold' : 'text-gris'}`}>
              {membership.name}
            </p>
            <div class="flex items-baseline gap-1 mb-2">
              <span class={`font-serif text-4xl ${membership.recommended ? 'text-gold' : 'text-burgundy'}`}>
                {membership.priceDisplay}
              </span>
              <span class={`font-garamond text-sm ${membership.recommended ? 'text-bone opacity-70' : 'text-gris'}`}>
                {membership.period}
              </span>
            </div>
            <p class={`font-garamond text-sm italic ${membership.recommended ? 'text-bone opacity-70' : 'text-gris'}`}>
              {membership.tagline}
            </p>
          </div>

          <GoldDivider class={membership.recommended ? 'opacity-40' : ''} />

          <!-- Benefits -->
          <ul class="space-y-3 flex-1 mb-8">
            {membership.benefits.map((benefit) => (
              <li class={`flex items-start gap-3 font-garamond text-sm leading-relaxed ${
                membership.recommended ? 'text-bone' : 'text-gris'
              }`}>
                <span class="text-gold mt-0.5 flex-shrink-0">✦</span>
                <span class={benefit.highlighted ? 'font-semibold' : ''}>{benefit.text}</span>
              </li>
            ))}
          </ul>

          <!-- Savings note -->
          <p class={`font-sans text-xs mb-6 ${membership.recommended ? 'text-bone opacity-60' : 'text-gris opacity-70'}`}>
            {membership.savings}
          </p>

          <!-- CTA -->
          <Button
            href="#cta"
            variant={membership.recommended ? 'gold' : 'secondary'}
            class="w-full text-center"
          >
            {membership.ctaText}
          </Button>
        </div>
      ))}
    </div>
  </div>
</section>
