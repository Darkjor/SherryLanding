---
import Button from './ui/Button.astro';
import GoldDivider from './ui/GoldDivider.astro';
import { getSiteSettings } from '../lib/content';

const settings = await getSiteSettings();
const whatsappDigits = settings.whatsapp.replace(/\D/g, '');
const whatsappHref = whatsappDigits
  ? `https://wa.me/${whatsappDigits}`
  : 'https://wa.me/521XXXXXXXXXX';
const address = settings.address || 'Zapopan, Jalisco';
const email = settings.email || 'hola@sherry.mx';
---

<section id="cta" class="section-padding bg-burgundy">
  <div class="container-sherry text-center">
    <p class="font-sans text-xs tracking-widest uppercase text-gold opacity-70 mb-6">Zapopan · Jalisco</p>
    <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl text-bone leading-tight max-w-3xl mx-auto mb-6 text-balance">
      No somos para todas. Somos exactamente para las que nos entienden.
    </h2>
    <GoldDivider class="mx-auto opacity-50" />
    <p class="font-garamond text-base sm:text-lg md:text-xl text-bone opacity-70 max-w-lg mx-auto mb-12 text-balance break-words">
      Tu primer ritual te espera. Reserva ahora y descubre por qué Sherry es diferente.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
      <span data-booking><Button href={whatsappHref} variant="gold">
        Reservar por WhatsApp
      </Button></span>
      <Button href="#membresias" variant="ghost">
        Ver membresías
      </Button>
    </div>

    <!-- Contact info -->
    <div class="flex flex-col sm:flex-row gap-4 sm:gap-8 justify-center items-center border-t border-bone border-opacity-10 pt-12">
      <p class="font-garamond text-sm text-bone opacity-50 break-all">
        · {address}
      </p>
      <p class="font-garamond text-sm text-bone opacity-50 break-all">
        Lun–Vie 9–20h · Sáb 9–18h · Dom 10–17h
      </p>
      <p class="font-garamond text-sm text-bone opacity-50 break-all">
        · {email}
      </p>
    </div>
  </div>
</section>
