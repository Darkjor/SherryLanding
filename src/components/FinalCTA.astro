---
import Button from './ui/Button.astro';
import GoldDivider from './ui/GoldDivider.astro';
---

<section id="cta" class="section-padding bg-burgundy">
  <div class="container-sherry text-center">
    <p class="font-sans text-xs tracking-widest uppercase text-gold opacity-70 mb-6">Zapopan · Jalisco</p>
    <h2 class="font-serif text-4xl md:text-5xl lg:text-6xl text-bone leading-tight max-w-3xl mx-auto mb-6">
      No somos para todas.<br />
      Somos exactamente para las que nos entienden.
    </h2>
    <GoldDivider class="mx-auto opacity-50" />
    <p class="font-garamond text-xl text-bone opacity-70 max-w-lg mx-auto mb-12">
      Tu primer ritual te espera. Reserva ahora y descubre por qué Sherry es diferente.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
      <!-- TODO: Replace with real WhatsApp number -->
      <Button href="https://wa.me/521XXXXXXXXXX" variant="gold">
        Reservar por WhatsApp
      </Button>
      <Button href="#membresias" variant="ghost">
        Ver membresías
      </Button>
    </div>

    <!-- Contact info -->
    <div class="flex flex-col sm:flex-row gap-8 justify-center items-center border-t border-bone border-opacity-10 pt-12">
      <!-- TODO: Replace with real address -->
      <p class="font-garamond text-sm text-bone opacity-50">
        📍 [Dirección en Zapopan, Jalisco] — TODO
      </p>
      <p class="font-garamond text-sm text-bone opacity-50">
        Lun–Vie 9–20h · Sáb 9–18h · Dom 10–17h
      </p>
      <!-- TODO: Replace with real email -->
      <p class="font-garamond text-sm text-bone opacity-50">
        ✉ [email@sherry.mx] — TODO
      </p>
    </div>
  </div>
</section>
