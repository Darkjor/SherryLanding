---
import { getSiteSettings } from '../lib/content';

const settings = await getSiteSettings();
const whatsappDigits = settings.whatsapp.replace(/\D/g, '');
const whatsappHref = whatsappDigits
  ? `https://wa.me/${whatsappDigits}`
  : 'https://wa.me/521XXXXXXXXXX';
const instagramHandle = settings.instagram || '@sherrymexico';
const instagramUser = instagramHandle.replace(/^@/, '');
const instagramHref = `https://instagram.com/${instagramUser}`;
---

<footer class="bg-burgundy-dark border-t border-bone border-opacity-10 border-t border-gold/20 py-16 px-4 sm:px-6 lg:px-10">
  <div class="container-sherry">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12 mb-12">

      <!-- Col 1: About -->
      <div>
        <p class="font-serif text-2xl text-bone mb-4">Sherry ✦</p>
        <p class="font-garamond text-sm text-bone opacity-50 leading-relaxed mb-4">
          Luxury Beauty House. Zapopan, Jalisco.
        </p>
        <p class="font-garamond text-sm text-bone opacity-40 italic">
          Where Beauty Becomes Ritual.
        </p>
      </div>

      <!-- Col 2: Services -->
      <div>
        <p class="font-sans text-xs tracking-widest uppercase text-gold opacity-60 mb-5">Rituales</p>
        <ul class="space-y-2.5">
          {['Gelish & Color en Gel', 'Uñas Esculturales', 'Manicure Coreana', 'Pedicure con Ritual', 'Tratamientos Capilares', 'Sherry At Home'].map(s => (
            <li><a href="#servicios" class="font-garamond text-sm text-bone opacity-50 hover:opacity-90 transition-opacity break-words focus-visible:opacity-100 focus-visible:outline-none focus-visible:underline focus-visible:decoration-gold">{s}</a></li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Company -->
      <div>
        <p class="font-sans text-xs tracking-widest uppercase text-gold opacity-60 mb-5">La Casa</p>
        <ul class="space-y-2.5">
          {['La Experiencia', 'Filosofía', 'Membresías', 'FAQ', 'Contacto'].map(l => (
            <li><a href="#" class="font-garamond text-sm text-bone opacity-50 hover:opacity-90 transition-opacity break-words focus-visible:opacity-100 focus-visible:outline-none focus-visible:underline focus-visible:decoration-gold">{l}</a></li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Contact -->
      <div>
        <p class="font-sans text-xs tracking-widest uppercase text-gold opacity-60 mb-5">Contacto</p>
        <ul class="space-y-3">
          <li class="font-garamond text-sm text-bone opacity-50">
            {settings.hours.map(h => (<span class="block">{h}</span>))}
          </li>
          <li><a href={whatsappHref} class="font-garamond text-sm text-bone opacity-50 hover:opacity-90 transition-opacity focus-visible:opacity-100 focus-visible:outline-none focus-visible:underline focus-visible:decoration-gold">WhatsApp</a></li>
          <li><a href={instagramHref} class="font-garamond text-sm text-bone opacity-50 hover:opacity-90 transition-opacity focus-visible:opacity-100 focus-visible:outline-none focus-visible:underline focus-visible:decoration-gold">{instagramHandle}</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="border-t border-bone border-opacity-10 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="font-garamond text-xs text-bone opacity-30 break-words">
        © 2025 Sherry Luxury Beauty House. Todos los derechos reservados.
      </p>
      <p class="font-sans text-xs text-bone opacity-20 tracking-widest uppercase">
        Zapopan · Jalisco · México
      </p>
    </div>
  </div>
</footer>
