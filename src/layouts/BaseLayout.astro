---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sherry ✦ Luxury Beauty House | Zapopan, Jalisco',
  description = 'Donde la belleza se convierte en ritual. Experiencias de belleza premium con estándares de hospitalidad internacional en Zapopan, Jalisco.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-image.jpg" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BeautySalon",
        "name": "Sherry Luxury Beauty House",
        "description": "Luxury Beauty House en Zapopan, Jalisco. Experiencias de belleza premium.",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Zapopan",
          "addressRegion": "Jalisco",
          "addressCountry": "MX"
        },
        "openingHours": ["Mo-Fr 09:00-20:00", "Sa 09:00-18:00", "Su 10:00-17:00"],
        "priceRange": "$$$"
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
